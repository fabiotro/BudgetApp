@model BudgetDetailViewModel
@{
    ViewData["Title"] = Model.Budget.Name;
}

<div class="d-flex justify-content-between align-items-start mb-2">
    <div>
        <h2>@Model.Budget.Name</h2>
        @if (!string.IsNullOrEmpty(Model.Budget.Description))
        {
            <p class="text-muted mb-1">@Model.Budget.Description</p>
        }
        <small class="text-muted">
            Lager: @Model.Camp.StartDate.ToString("dd.MM.yyyy") – @Model.Camp.EndDate.ToString("dd.MM.yyyy")
            @if (!string.IsNullOrEmpty(Model.Camp.MainLeader))
            {
                <span> | Lagerleiter: @Model.Camp.MainLeader</span>
            }
        </small>
    </div>
    <a asp-action="NewBudget" asp-route-campId="@Model.Camp.Id" class="btn btn-outline-secondary btn-sm">Lagerdaten bearbeiten</a>
</div>
<hr />

@if (Model.Groups.Any())
{
    <form asp-action="SaveRealAmounts" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="budgetId" value="@Model.Budget.Id" />

        @{ int pi = 0; }

        @foreach (var catGroup in Model.Groups)
        {
            <h4 class="mt-4">@catGroup.Category.Name</h4>

            @foreach (var subGroup in catGroup.SubGroups)
            {
                @if (subGroup.SubCategory != null)
                {
                    <h6 class="text-muted">@subGroup.SubCategory.Name</h6>
                }
                <table class="table table-sm table-bordered mb-2">
                    <thead class="table-light">
                        <tr>
                            <th>Position</th>
                            <th class="text-end">Fixbetrag (prov.)</th>
                            <th class="text-end">Anzahl (prov.)</th>
                            <th class="text-end">Einheitspreis (prov.)</th>
                            <th class="text-end">Total (prov.)</th>
                            <th class="text-end">Fixbetrag (def.)</th>
                            <th class="text-end">Anzahl (def.)</th>
                            <th class="text-end">Einheitspreis (def.)</th>
                            <th class="text-end">Total (def.)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pos in subGroup.Positions)
                        {
                            <input type="hidden" name="positions[@pi].Id" value="@pos.Id" />
                            <tr>
                                <td>@pos.Name</td>
                                <td class="text-end">@pos.FixedAmount_fc.ToString("N2")</td>
                                <td class="text-end">@pos.Quantity_fc.ToString("N2")</td>
                                <td class="text-end">@pos.UnitAmount_fc.ToString("N2")</td>
                                <td class="text-end fw-semibold">@pos.TotalAmount_fc.ToString("N2")</td>
                                <td>
                                    <input class="form-control form-control-sm text-end" type="number" step="0.01" min="0"
                                           name="positions[@pi].FixedAmount_rl"
                                           value="@pos.FixedAmount_rl" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm text-end" type="number" step="0.01" min="0"
                                           name="positions[@pi].Quantity_rl"
                                           value="@pos.Quantity_rl" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm text-end" type="number" step="0.01" min="0"
                                           name="positions[@pi].UnitAmount_rl"
                                           value="@pos.UnitAmount_rl" />
                                </td>
                                <td class="text-end fw-semibold">@pos.TotalAmount_rl.ToString("N2")</td>
                                <td>
                                    <button type="submit" form="deletePos-@pos.Id"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Position «@pos.Name» wirklich löschen?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                            pi++;
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="4" class="fw-bold">Total @(subGroup.SubCategory?.Name ?? "–")</td>
                            <td class="text-end fw-bold">@subGroup.TotalAmount_fc.ToString("N2")</td>
                            <td colspan="3"></td>
                            <td class="text-end fw-bold">@subGroup.TotalAmount_rl.ToString("N2")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            }

            <div class="text-end mb-3">
                <strong>Total @catGroup.Category.Name:</strong>
                @catGroup.TotalAmount_fc.ToString("N2") (prov.) /
                @catGroup.TotalAmount_rl.ToString("N2") (def.)
            </div>
        }

        <div class="card mt-4">
            <div class="card-body">
                <div class="row">
                    <div class="col">
                        <h5 class="card-title">Gesamttotal</h5>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <span class="text-muted">Provisorisch:</span>
                        <strong>CHF @Model.TotalAmount_fc.ToString("N2")</strong>
                    </div>
                    <div class="col">
                        <span class="text-muted">Definitiv:</span>
                        <strong>CHF @Model.TotalAmount_rl.ToString("N2")</strong>
                    </div>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Definitiv-Beträge speichern</button>
        <a asp-action="Index" class="btn btn-outline-secondary mt-3 ms-2">Zur Übersicht</a>
    </form>

    @* Hidden delete forms — associated via HTML5 form attribute to buttons inside the SaveRealAmounts form *@
    @foreach (var catGroup in Model.Groups)
    {
        @foreach (var subGroup in catGroup.SubGroups)
        {
            @foreach (var pos in subGroup.Positions)
            {
                <form id="deletePos-@pos.Id" asp-action="DeleteBudgetPosition" method="post" style="display:none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@pos.Id" />
                    <input type="hidden" name="budgetId" value="@Model.Budget.Id" />
                </form>
            }
        }
    }
}
else
{
    <p class="text-muted">Keine Positionen vorhanden.</p>
    <a asp-action="Index" class="btn btn-outline-secondary">Zur Übersicht</a>
}

<hr class="mt-4" />
<h5>Position hinzufügen</h5>
<form asp-action="AddBudgetPosition" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="BudgetId" value="@Model.Budget.Id" />

    <div class="row g-2 align-items-end mb-2">
        <div class="col-md-3">
            <label class="form-label">Name</label>
            <input type="text" name="Name" class="form-control form-control-sm" required />
        </div>
        <div class="col-md-1">
            <label class="form-label">Typ</label>
            <select name="PositionTypeId" class="form-select form-select-sm" required>
                <option value="0">– Typ –</option>
                @foreach (var pt in Model.PositionTypes)
                {
                    <option value="@pt.Id">@pt.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Kategorie</label>
            <select name="CategoryId" id="budgetAddCategoryId" class="form-select form-select-sm" required>
                <option value="0">– Kategorie –</option>
                @foreach (var cat in Model.AllCategories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Unterkategorie</label>
            <select name="SubCategoryId" id="budgetAddSubCategoryId" class="form-select form-select-sm">
                <option value="">– Unterkategorie –</option>
                @foreach (var sub in Model.AllSubCategories)
                {
                    <option value="@sub.Id" data-category="@sub.CategoryId">@sub.Name</option>
                }
            </select>
        </div>
        <div class="col-md-1">
            <label class="form-label">Fixbetrag</label>
            <input type="number" name="FixedAmount_fc" class="form-control form-control-sm text-end" step="0.01" min="0" value="0" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Anzahl</label>
            <input type="number" name="Quantity_fc" class="form-control form-control-sm text-end" step="0.01" min="0" value="0" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Einheitspreis</label>
            <input type="number" name="UnitAmount_fc" class="form-control form-control-sm text-end" step="0.01" min="0" value="0" />
        </div>
        <div class="col-md-1 d-flex justify-content-end">
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-square"></i>
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const categorySelect = document.getElementById('budgetAddCategoryId');
            const subCategorySelect = document.getElementById('budgetAddSubCategoryId');
            const allSubOptions = Array.from(subCategorySelect.querySelectorAll('option[data-category]'));

            function filterSubCategories() {
                const selectedCategoryId = categorySelect.value;
                subCategorySelect.innerHTML = '<option value="">– Unterkategorie –</option>';
                allSubOptions
                    .filter(opt => !selectedCategoryId || selectedCategoryId === '0' || opt.dataset.category === selectedCategoryId)
                    .forEach(opt => subCategorySelect.appendChild(opt.cloneNode(true)));
            }

            categorySelect.addEventListener('change', filterSubCategories);
        })();
    </script>
}
