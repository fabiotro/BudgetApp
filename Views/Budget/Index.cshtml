@model List<BudgetListViewModel>
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Localizer["PageHeading"]</h2>
    <a asp-action="NewBudget" class="btn btn-primary">
        <span class="me-2">@Localizer["CreateBudgetButton"]</span>
        <i class="bi bi-plus-square"></i>
    </a>
</div>
<hr />

@if (!Model.Any())
{
    <p class="text-muted">@Localizer["NoDataMessage"] <a asp-action="NewBudget">@Localizer["NoDataCreateLink"]</a></p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>@Localizer["ColBudget"]</th>
                <th>@Localizer["ColPeriod"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.Budget.Name</strong>
                        @if (!string.IsNullOrEmpty(item.Budget.Description))
                        {
                            <br /><small class="text-muted">@item.Budget.Description</small>
                        }
                    </td>
                    <td>
                        @if (item.Camp != null)
                        {
                            @($"{item.Camp.StartDate:dd.MM.yyyy} – {item.Camp.EndDate:dd.MM.yyyy}")
                        }
                        else { <span class="text-muted">–</span> }
                    </td>
                    <td class="text-end">
                        <a asp-action="Detail" asp-route-id="@item.Budget.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye"></i>
                        </a>
                        @if (item.Camp != null)
                        {
                            <a asp-action="NewBudget" asp-route-campId="@item.Camp.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pen"></i>
                            </a>
                            <a asp-controller="Camp" asp-action="Detail" asp-route-id="@item.Camp.Id" class="btn btn-sm btn-outline-primary" title="@Localizer["CampOverviewTooltip"]">
                                <i class="bi bi-people"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
