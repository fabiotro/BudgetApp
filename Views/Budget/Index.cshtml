@model List<BudgetListViewModel>
@{
    ViewData["Title"] = "Budgets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Budgets</h2>
    <a asp-action="NewBudget" class="btn btn-primary">Neues Lagerbudget</a>
</div>
<hr />

@if (!Model.Any())
{
    <p class="text-muted">Noch keine Budgets vorhanden. <a asp-action="NewBudget">Jetzt erstellen.</a></p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Budget</th>
                <th>Lager</th>
                <th>Lagerleiter</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.Budget.Name</strong>
                        @if (!string.IsNullOrEmpty(item.Budget.Description))
                        {
                            <br /><small class="text-muted">@item.Budget.Description</small>
                        }
                    </td>
                    <td>@item.Camp.StartDate.ToString("dd.MM.yyyy") – @item.Camp.EndDate.ToString("dd.MM.yyyy")</td>
                    <td>@(item.Camp.MainLeader ?? "–")</td>
                    <td class="text-end">
                        <a asp-action="Detail" asp-route-id="@item.Budget.Id" class="btn btn-sm btn-outline-primary">Anzeigen</a>
                        <a asp-action="NewBudget" asp-route-campId="@item.Camp.Id" class="btn btn-sm btn-outline-secondary">Lager bearbeiten</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
