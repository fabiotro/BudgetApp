@model NewBudgetViewModel
@{
    ViewData["Title"] = Localizer["PageHeading"].Value;
}

<h2>@Localizer["PageHeading"]</h2>
<hr />

<h3>@Localizer["CampDataSection"]</h3>
@using (Html.BeginForm("UpsertCamp", "Budget", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Camp.Id)
    <div class="row">
        <div class="col">
            <div class="mb-3">
                @Html.LabelFor(m => m.Camp.StartDate, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Camp.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.Camp.StartDate, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col">
            <div class="mb-3">
                @Html.LabelFor(m => m.Camp.EndDate, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Camp.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.Camp.EndDate, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <h5>@Localizer["ProvisionalHeading"]</h5>
            <hr />
            <div class="mb-3">
                @Html.LabelFor(m => m.Camp.ParticipantsCount_fc, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    @Html.TextBoxFor(m => m.Camp.ParticipantsCount_fc, new { @class = "form-control text-end", type = "number" })
                </div>
                @Html.ValidationMessageFor(m => m.Camp.ParticipantsCount_fc, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Camp.js_PersonsCount_fc, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    @Html.TextBoxFor(m => m.Camp.js_PersonsCount_fc, new { @class = "form-control text-end", type = "number" })
                </div>
                @Html.ValidationMessageFor(m => m.Camp.js_PersonsCount_fc, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Camp.LeadersTeamCount_fc, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    @Html.TextBoxFor(m => m.Camp.LeadersTeamCount_fc, new { @class = "form-control text-end", type = "number" })
                </div>
                @Html.ValidationMessageFor(m => m.Camp.LeadersTeamCount_fc, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col">
            <h5>@Localizer["FinalHeading"]</h5>
            <hr />
            <div class="mb-3">
                @Html.LabelFor(m => m.Camp.ParticipantsCount_rl, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    @Html.TextBoxFor(m => m.Camp.ParticipantsCount_rl, new { @class = "form-control text-end", type = "number" })
                </div>
                @Html.ValidationMessageFor(m => m.Camp.ParticipantsCount_rl, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Camp.js_PersonsCount_rl, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    @Html.TextBoxFor(m => m.Camp.js_PersonsCount_rl, new { @class = "form-control text-end", type = "number" })
                </div>
                @Html.ValidationMessageFor(m => m.Camp.js_PersonsCount_rl, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Camp.LeadersTeamCount_rl, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    @Html.TextBoxFor(m => m.Camp.LeadersTeamCount_rl, new { @class = "form-control text-end", type = "number" })
                </div>
                @Html.ValidationMessageFor(m => m.Camp.LeadersTeamCount_rl, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary">
            <span class="me-2">@Localizer["SaveCampDataButton"]</span>
            <i class="bi bi-floppy ml-3"></i>
        </button>
    </div>
}

<hr />
<h3>@Localizer["BudgetsSection"]</h3>

@if (Model.Camp.Id == 0)
{
    <p class="text-muted">@Localizer["SaveFirstMessage"]</p>
}
else
{
    @if (Model.ExistingBudgets.Any())
    {
        <table class="table table-sm mb-3">
            <thead>
                <tr>
                    <th>@Localizer["ColName"]</th>
                    <th>@Localizer["ColDescription"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var budget in Model.ExistingBudgets)
                {
                    <tr>
                        <td>@budget.Name</td>
                        <td>@budget.Description</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Detail" asp-route-id="@budget.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i>
                            </a>
                            <form asp-action="DeleteBudget" method="post" class="d-inline"
                                  onsubmit="return confirm('@string.Format(Localizer["ConfirmDeleteBudget"].Value, budget.Name)')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@budget.Id" />
                                <input type="hidden" name="campId" value="@Model.Camp.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="d-flex justify-content-end">
        <button type="button" class="btn btn-primary" id="openCreateBudgetModal">
            @Localizer["NewBudgetButton"] <i class="bi bi-plus-square"></i>
        </button>
    </div>

    <div id="createBudgetModalContainer"></div>

    <script>
        document.getElementById('openCreateBudgetModal').addEventListener('click', function () {
            fetch('@Url.Action("CreateBudgetModal", "Budget", new { campId = Model.Camp.Id })')
                .then(r => r.text())
                .then(html => {
                    const container = document.getElementById('createBudgetModalContainer');
                    container.innerHTML = html;
                    new bootstrap.Modal(container.querySelector('.modal')).show();
                });
        });
    </script>
}

@if (Model.Camp.Id > 0)
{
    <hr />
    <h3>@Localizer["LeadershipSection"]</h3>

    @if (Model.CampUsers.Any())
    {
        <table class="table table-sm mb-3">
            <thead>
                <tr>
                    <th>@Localizer["ColName"]</th>
                    <th>@Localizer["ColEmail"]</th>
                    <th>@Localizer["ColRole"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cu in Model.CampUsers)
                {
                    <tr>
                        <td>@cu.DisplayName</td>
                        <td>@cu.Email</td>
                        <td>
                            @{
                                var badgeClass = cu.CampUserRoleId switch
                                {
                                    1 => "bg-primary",
                                    3 => "bg-info",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@cu.RoleName</span>
                        </td>
                        <td class="text-end">
                            @if (cu.CampUserRoleId != 1)
                            {
                                <form asp-action="RemoveCampUser" method="post" class="d-inline"
                                      onsubmit="return confirm('@Localizer["ConfirmRemovePerson"].Value')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="campUserId" value="@cu.Id" />
                                    <input type="hidden" name="campId" value="@Model.Camp.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.AllUsers.Any())
    {
        var addedUserIds = Model.CampUsers.Select(cu => cu.UserId).ToHashSet();
        var availableUsers = Model.AllUsers.Where(u => !addedUserIds.Contains(u.Id)).ToList();

        @if (availableUsers.Any())
        {
            <form asp-action="AddCampUser" method="post" class="d-flex gap-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="campId" value="@Model.Camp.Id" />
                <div>
                    <label class="form-label mb-1">@Localizer["AddPersonLabel"]</label>
                    <select name="userId" class="form-select form-select-sm">
                        @foreach (var u in availableUsers)
                        {
                            <option value="@u.Id">@u.DisplayName (@u.Email)</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-person-plus"></i> @Localizer["AddPersonButton"]
                </button>
            </form>
        }
    }
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
