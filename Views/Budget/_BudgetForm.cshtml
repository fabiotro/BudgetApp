@model BudgetFormViewModel
@{
    bool isCreate = Model.Id == 0;
}

@Html.HiddenFor(m => m.Id)

<div class="mb-3">
    @Html.LabelFor(m => m.Name, new { @class = "form-label" })
    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
</div>
<div class="mb-3">
    @Html.LabelFor(m => m.Description, new { @class = "form-label" })
    @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
</div>

<div class="row">
    <div class="col">
        <div class="mb-3">
            @Html.LabelFor(m => m.StartDate, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col">
        <div class="mb-3">
            @Html.LabelFor(m => m.EndDate, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
        </div>
    </div>
</div>
<div class="mb-3">
    @Html.LabelFor(m => m.MainLeader, new { @class = "form-label" })
    @Html.TextBoxFor(m => m.MainLeader, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.MainLeader, "", new { @class = "text-danger" })
</div>
<div class="row">
    <div class="col">
        <h5>Provisorisch</h5>
        <hr />
        <div class="mb-3">
            @Html.LabelFor(m => m.ParticipantsCount_fc, new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                @Html.TextBoxFor(m => m.ParticipantsCount_fc, new { @class = "form-control text-end", type = "number" })
            </div>
            @Html.ValidationMessageFor(m => m.ParticipantsCount_fc, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.js_PersonsCount_fc, new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                @Html.TextBoxFor(m => m.js_PersonsCount_fc, new { @class = "form-control text-end", type = "number" })
            </div>
            @Html.ValidationMessageFor(m => m.js_PersonsCount_fc, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.LeadersTeamCount_fc, new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                @Html.TextBoxFor(m => m.LeadersTeamCount_fc, new { @class = "form-control text-end", type = "number" })
            </div>
            @Html.ValidationMessageFor(m => m.LeadersTeamCount_fc, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col">
        <h5>Definitiv</h5>
        <hr />
        <div class="mb-3">
            @Html.LabelFor(m => m.ParticipantsCount_rl, new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                @Html.TextBoxFor(m => m.ParticipantsCount_rl, new { @class = "form-control text-end", type = "number" })
            </div>
            @Html.ValidationMessageFor(m => m.ParticipantsCount_rl, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.js_PersonsCount_rl, new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                @Html.TextBoxFor(m => m.js_PersonsCount_rl, new { @class = "form-control text-end", type = "number" })
            </div>
            @Html.ValidationMessageFor(m => m.js_PersonsCount_rl, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.LeadersTeamCount_rl, new { @class = "form-label" })
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                @Html.TextBoxFor(m => m.LeadersTeamCount_rl, new { @class = "form-control text-end", type = "number" })
            </div>
            @Html.ValidationMessageFor(m => m.LeadersTeamCount_rl, "", new { @class = "text-danger" })
        </div>
    </div>
</div>

@if (isCreate)
{
    <div class="mb-3">
        <label class="form-label">Vorlage</label>
        @Html.DropDownListFor(
            m => m.SelectedTemplateBudgetId,
            new SelectList(Model.AvailableTemplates, "Id", "Name"),
            "-- Vorlage auswählen --",
            new { @class = "form-select" }
        )
        <div class="form-text">Positionen werden beim Erstellen aus der gewählten Vorlage übernommen.</div>
    </div>
}
