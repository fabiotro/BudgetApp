@model CategoryIndexViewModel
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Localizer["PageHeading"]</h2>
    <a asp-action="UpsertCategory" class="btn btn-primary">
        <span class="me-2">@Localizer["CreateCategoryButton"]</span>
        <i class="bi bi-plus-square"></i>
    </a>
</div>
<hr />

@if (!Model.Categories.Any())
{
    <p class="text-muted">@Localizer["NoDataMessage"] <a asp-action="UpsertCategory">@Localizer["NoDataCreateLink"]</a></p>
}
else
{
    @foreach (var item in Model.Categories)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong>@item.Category.Name</strong>
                    @if (!string.IsNullOrEmpty(item.Category.Description))
                    {
                        <small class="text-muted ms-2">@item.Category.Description</small>
                    }
                    <small class="text-muted ms-2">(@Localizer["SortIndexLabel"]: @item.Category.SortIndex)</small>
                </div>
                <div>
                    <a asp-action="UpsertCategory" asp-route-id="@item.Category.Id"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-pen"></i>
                    </a>
                    <button type="submit" form="deleteCat-@item.Category.Id"
                            class="btn btn-sm btn-outline-danger"
                            onclick="return confirm('@string.Format(Localizer["ConfirmDeleteCategory"].Value, item.Category.Name)')">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>

            @if (item.SubCategories.Any())
            {
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var sub in item.SubCategories)
                            {
                                <tr>
                                    <td class="ps-4 text-muted" style="width: 1rem;">└</td>
                                    <td>@sub.Name</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(sub.Description))
                                        {
                                            <small class="text-muted">@sub.Description</small>
                                        }
                                    </td>
                                    <td class="text-muted text-end pe-3">
                                        <small>@Localizer["SortIndexLabel"]: @sub.SortIndex</small>
                                    </td>
                                    <td class="text-end pe-3" style="white-space: nowrap;">
                                        <a asp-action="UpsertSubCategory" asp-route-id="@sub.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pen"></i>
                                        </a>
                                        <form asp-action="DeleteSubCategory" method="post" class="d-inline"
                                              onsubmit="return confirm('@string.Format(Localizer["ConfirmDeleteSubCategory"].Value, sub.Name)')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@sub.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="card-footer">
                <a asp-action="UpsertSubCategory" asp-route-categoryId="@item.Category.Id"
                   class="btn btn-sm btn-outline-primary">
                    <span class="me-2">@Localizer["AddSubCategoryButton"]</span>
                    <i class="bi bi-plus-square"></i>
                </a>
            </div>
        </div>
    }

    @* Hidden delete forms for categories — associated via HTML5 form attribute *@
    @foreach (var item in Model.Categories)
    {
        <form id="deleteCat-@item.Category.Id" asp-action="DeleteCategory" method="post" style="display:none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@item.Category.Id" />
        </form>
    }
}
