@model CategoryModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Neue Kategorie" : "Kategorie bearbeiten";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@(isNew ? "Neue Kategorie erstellen" : "Kategorie bearbeiten")</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Zur Übersicht</a>
</div>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="UpsertCategory" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SortIndex" class="form-label"></label>
                <input asp-for="SortIndex" class="form-control" type="number" min="0" />
                <span asp-validation-for="SortIndex" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">@(isNew ? "Erstellen" : "Speichern")</button>
            @if (!isNew)
            {
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Abbrechen</a>
            }
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
