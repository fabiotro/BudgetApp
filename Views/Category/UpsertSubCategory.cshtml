@model UpsertSubCategoryViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? Localizer["CreatePageTitle"].Value : Localizer["EditPageTitle"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@(isNew ? Localizer["CreateHeading"] : Localizer["EditHeading"])</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["ToOverviewButton"]</a>
</div>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="UpsertSubCategory" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">@Localizer["CategoryLabel"]</label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="0">@Localizer["CategoryPlaceholder"]</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SortIndex" class="form-label"></label>
                <input asp-for="SortIndex" class="form-control" type="number" min="0" />
                <span asp-validation-for="SortIndex" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">@(isNew ? Localizer["CreateButton"] : Localizer["SaveButton"])</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">@Localizer["CancelButton"]</a>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
