@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
}

<div class="text-center py-5">
    <h1 class="display-4">@Localizer["Heading"]</h1>
    <p class="lead text-muted">@Localizer["Tagline"]</p>
    <hr class="my-4" />
    <a asp-controller="Budget" asp-action="NewBudget" class="btn btn-primary btn-lg me-2">@Localizer["NewBudgetButton"]</a>
    <a asp-controller="Budget" asp-action="Index" class="btn btn-outline-secondary btn-lg">@Localizer["AllBudgetsButton"]</a>
</div>
