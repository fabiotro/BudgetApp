@{
    ViewData["Title"] = "BudgetApp";
}

<div class="text-center py-5">
    <h1 class="display-4">BudgetApp</h1>
    <p class="lead text-muted">Lagerbudgets erstellen und verwalten.</p>
    <hr class="my-4" />
