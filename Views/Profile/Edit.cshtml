@model EditProfileViewModel
@{
    ViewData["Title"] = "Profil bearbeiten";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Profil bearbeiten</h2>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Zurück
    </a>
</div>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-control" />
                <span asp-validation-for="DisplayName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IBAN" class="form-label"></label>
                <input asp-for="IBAN" class="form-control" placeholder="CH93 0076 2011 6238 5295 7" />
                <div class="form-text">
                    Wird für die Rückerstattung von Lagerausgaben verwendet.
                </div>
                <span asp-validation-for="IBAN" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Speichern <i class="bi bi-floppy"></i>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
