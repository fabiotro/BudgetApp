@model AddPositionPartialViewModel

<hr class="mt-4" />
<h5>Position hinzufügen</h5>
<form asp-action="@Model.FormAction" asp-controller="@Model.FormController" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="@Model.ParentIdFieldName" value="@Model.ParentId" />

    <div class="row g-2 align-items-end mb-2">
        <div class="col-md-3">
            <label class="form-label">Name</label>
            <input type="text" name="Name" class="form-control form-control-sm" required />
        </div>
        <div class="col-md-1">
            <label class="form-label">Typ</label>
            <select name="PositionTypeId" class="form-select form-select-sm" required>
                <option value="0">– Typ –</option>
                @foreach (var pt in Model.PositionTypes)
                {
                    <option value="@pt.Id">@pt.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Kategorie</label>
            <select name="CategoryId" id="@Model.CategorySelectId" class="form-select form-select-sm" required>
                <option value="0">– Kategorie –</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Unterkategorie</label>
            <select name="SubCategoryId" id="@Model.SubCategorySelectId" class="form-select form-select-sm">
                <option value="">– Unterkategorie –</option>
                @foreach (var sub in Model.SubCategories)
                {
                    <option value="@sub.Id" data-category="@sub.CategoryId">@sub.Name</option>
                }
            </select>
        </div>
        <div class="col-md-1">
            <label class="form-label">Fixbetrag</label>
            <input type="number" name="FixedAmount" class="form-control form-control-sm text-end" step="0.01" min="0" value="0" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Anzahl</label>
            <input type="number" name="Quantity" class="form-control form-control-sm text-end" step="0.01" min="0" value="0" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Einheitspreis</label>
            <input type="number" name="UnitAmount" class="form-control form-control-sm text-end" step="0.01" min="0" value="0" />
        </div>
        <div class="col-md-1 d-flex justify-content-end">
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-square"></i>
            </button>
        </div>
    </div>
</form>

<script>
    (function () {
        const categorySelect = document.getElementById('@Model.CategorySelectId');
        const subCategorySelect = document.getElementById('@Model.SubCategorySelectId');
        const allSubOptions = Array.from(subCategorySelect.querySelectorAll('option[data-category]'));

        function filterSubCategories() {
            const selectedCategoryId = categorySelect.value;
            subCategorySelect.innerHTML = '<option value="">– Unterkategorie –</option>';
            allSubOptions
                .filter(opt => !selectedCategoryId || selectedCategoryId === '0' || opt.dataset.category === selectedCategoryId)
                .forEach(opt => subCategorySelect.appendChild(opt.cloneNode(true)));
        }

        categorySelect.addEventListener('change', filterSubCategories);
    })();
</script>
