@model int
<li class="nav-item me-2">
    <a class="nav-link text-dark position-relative" href="#"
       id="inviteBellToggle"
       role="button"
       data-bs-toggle="offcanvas" data-bs-target="#inviteOffcanvas"
       data-invite-url="@Url.Action("Pending", "Invite")">
        <i class="bi bi-bell"></i>
        <span id="inviteBadge"
              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger @(Model == 0 ? "d-none" : "")">
            @(Model > 0 ? Model.ToString() : "")
        </span>
    </a>
</li>
