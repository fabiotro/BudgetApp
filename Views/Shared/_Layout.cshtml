@using System.Security.Claims
@inject BudgetApp.Data.Repositories.IBudgetInviteRepository<BudgetApp.Models.BudgetInviteModel> InviteRepo
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    int pendingInviteCount = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        int bellUserId = int.Parse(User.FindFirst(ClaimTypes.NameIdentifier)!.Value);
        pendingInviteCount = await InviteRepo.GetPendingCountByInvitedUserId(bellUserId);
    }
}
<!DOCTYPE html>
<html lang="de-ch">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BudgetApp</title>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <meta name="RequestVerificationToken" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BudgetApp.styles.css" asp-append-version="true" />
</head>
<body>
    <partial name="_ToastNotification" />
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BudgetApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Budget" asp-action="Index">Budgets</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="TemplateBudget" asp-action="Index">Vorlagen</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Category" asp-action="Index">Kategorien</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" id="profileNavLink"
                                   asp-controller="Profile" asp-action="Edit"
                                   data-bs-toggle="offcanvas" data-bs-target="#profileOffcanvas">
                                    <i class="bi bi-person-circle"></i> <span id="profileDisplayName">@User.Identity.Name</span>
                                </a>
                            </li>
                            <partial name="_InviteBell" model="pendingInviteCount" />
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-secondary"><i class="bi bi-box-arrow-right"></i></button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="offcanvas offcanvas-end" tabindex="-1" id="profileOffcanvas" aria-labelledby="profileOffcanvasLabel" style="width: 420px;">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="profileOffcanvasLabel">Profil bearbeiten</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body" id="profileOffcanvasBody">
                <div class="text-muted">Wird geladen…</div>
            </div>
        </div>
        <div class="offcanvas offcanvas-end" tabindex="-1" id="inviteOffcanvas" aria-labelledby="inviteOffcanvasLabel" style="width: 420px;">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="inviteOffcanvasLabel">Einladungen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <div id="inviteListContainer">
                    <div class="text-muted">Wird geladen…</div>
                </div>
            </div>
        </div>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year | BudgetApp | Fabio Trosi v/o Strolch
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
