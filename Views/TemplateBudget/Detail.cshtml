@model TemplateBudgetDetailViewModel
@{
    ViewData["Title"] = Model.TemplateBudget.Name;
}

<div class="d-flex justify-content-between align-items-start mb-2">
    <div>
        <h2>@Model.TemplateBudget.Name</h2>
        @if (!string.IsNullOrEmpty(Model.TemplateBudget.Description))
        {
            <p class="text-muted mb-1">@Model.TemplateBudget.Description</p>
        }
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#templateAddPositionModal">
            Position hinzufügen <i class="bi bi-plus-square"></i>
        </button>
        <a asp-action="Upsert" asp-route-id="@Model.TemplateBudget.Id" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-pen"></i>
        </a>
    </div>
</div>
<hr />

@if (Model.Groups.Any())
{
    @foreach (var catGroup in Model.Groups)
    {
        <h4 class="mt-4">@catGroup.Category.Name</h4>

        <table class="table table-sm table-bordered mb-2">
            <thead class="table-light">
                <tr>
                    <th>Position</th>
                    <th class="text-end">Fixbetrag</th>
                    <th class="text-end">Anzahl</th>
                    <th class="text-end">Einheitspreis</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var subGroup in catGroup.SubGroups)
                {
                    @if (subGroup.SubCategory != null)
                    {
                        <tr class="table-secondary">
                            <td colspan="6" class="fw-semibold py-1">@subGroup.SubCategory.Name</td>
                        </tr>
                    }
                    @foreach (var pos in subGroup.Positions)
                    {
                        <tr class="@(pos.IsIncome ? "table-success" : "table-danger")">
                            <td class="@(subGroup.SubCategory != null ? "ps-3" : "")">@pos.Name</td>
                            <td class="text-end">@(pos.FixedAmount == null ? "–" : "CHF " + pos.FixedAmount?.ToString("N2"))</td>
                            <td class="text-end">@(pos.Quantity?.ToString("N2") ?? "–")</td>
                            <td class="text-end">@(pos.UnitAmount == null ? "–" : "CHF " + pos.UnitAmount?.ToString("N2"))</td>
                            <td class="text-end fw-semibold">CHF @pos.TotalAmount.ToString("N2")</td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        onclick="openEditPositionModal(@pos.Id)">
                                    <i class="bi bi-pen"></i>
                                </button>
                                <form asp-action="DeletePosition" method="post" class="d-inline"
                                      onsubmit="return confirm('Position «@pos.Name» wirklich löschen?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@pos.Id" />
                                    <input type="hidden" name="templateBudgetId" value="@Model.TemplateBudget.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    <tr class="table-light border-top border-secondary border-opacity-25">
                        <td colspan="4" class="fw-bold">Total @(subGroup.SubCategory?.Name ?? "übrige Positionen")</td>
                        <td class="text-end @(subGroup.TotalAmount >= 0 ? "text-success" : "text-danger")">CHF @subGroup.TotalAmount.ToString("N2")</td>
                        <td></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-secondary">
                    <td colspan="4" class="fw-bold">Total @catGroup.Category.Name</td>
                    <td class="fw-bold text-end @(catGroup.TotalAmount >= 0 ? "text-success" : "text-danger")">CHF @catGroup.TotalAmount.ToString("N2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    }

    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title mb-3">Gesamttotal</h5>
            <div class="row mb-1">
                <div class="col-6 col-md-3">Einnahmen</div>
                <div class="col-6 col-md-3 text-success text-end">CHF @Model.TotalIncome.ToString("N2")</div>
            </div>
            <div class="row mb-1">
                <div class="col-6 col-md-3">Ausgaben</div>
                <div class="col-6 col-md-3 text-danger text-end">CHF @Model.TotalExpenses.ToString("N2")</div>
            </div>
            <hr class="my-2" />
            <div class="row">
                <div class="col-6 col-md-3 fw-bold">Saldo</div>
                <div class="col-6 col-md-3 text-end fw-bold @(Model.TotalAmount >= 0 ? "text-success" : "text-danger")">CHF @Model.TotalAmount.ToString("N2")</div>
            </div>
        </div>
    </div>
}
else
{
    <p class="text-muted mb-4">Noch keine Positionen vorhanden.</p>
}

<div id="editPositionModalContainer"></div>

<script>
    function openEditPositionModal(id) {
        fetch('@Url.Action("EditPositionModal", "TemplateBudget")?id=' + id)
            .then(r => r.text())
            .then(html => {
                const container = document.getElementById('editPositionModalContainer');
                container.innerHTML = html;
                initCurrencyInputs(container);
                initCountInputs(container);
                new bootstrap.Modal(container.querySelector('.modal')).show();
            });
    }
</script>

@await Html.PartialAsync("_AddPosition", new AddPositionPartialViewModel
{
    ModalId = "templateAddPositionModal",
    FormAction = "AddPosition",
    FormController = "TemplateBudget",
    ParentIdFieldName = "TemplateBudgetId",
    ParentId = Model.TemplateBudget.Id,
    CategorySelectId = "templateAddCategoryId",
    SubCategorySelectId = "templateAddSubCategoryId",
    PositionTypes = Model.NewPosition.PositionTypes,
    Categories = Model.NewPosition.Categories,
    SubCategories = Model.NewPosition.SubCategories
})
