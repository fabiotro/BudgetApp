@model TemplateBudgetDetailViewModel
@{
    ViewData["Title"] = Model.TemplateBudget.Name;
}

<div class="d-flex justify-content-between align-items-start mb-2">
    <div>
        <h2>@Model.TemplateBudget.Name</h2>
        @if (!string.IsNullOrEmpty(Model.TemplateBudget.Description))
        {
            <p class="text-muted mb-1">@Model.TemplateBudget.Description</p>
        }
    </div>
    <div>
        <a asp-action="Upsert" asp-route-id="@Model.TemplateBudget.Id" class="btn btn-outline-secondary btn-sm">Bearbeiten</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1">Zur Übersicht</a>
    </div>
</div>
<hr />

<h4>Positionen</h4>

@if (Model.Positions.Any())
{
    <table class="table table-sm table-hover mb-4">
        <thead class="table-light">
            <tr>
                <th>Reihenfolge</th>
                <th>Name</th>
                <th>Typ</th>
                <th>Kategorie</th>
                <th>Unterkategorie</th>
                <th class="text-end">Fixbetrag</th>
                <th class="text-end">Anzahl</th>
                <th class="text-end">Einheitspreis</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pos in Model.Positions)
            {
                <tr>
                    <td>@pos.SortIndex</td>
                    <td>@pos.Name</td>
                    <td>@pos.PositionTypeName</td>
                    <td>@pos.CategoryName</td>
                    <td>@pos.SubCategoryName</td>
                    <td class="text-end">@(pos.FixedAmount?.ToString("N2") ?? "–")</td>
                    <td class="text-end">@(pos.Quantity?.ToString("N2") ?? "–")</td>
                    <td class="text-end">@(pos.UnitAmount?.ToString("N2") ?? "–")</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="EditPosition" asp-route-id="@pos.Id" class="btn btn-sm btn-outline-secondary">Bearbeiten</a>
                        <form asp-action="DeletePosition" method="post" class="d-inline"
                              onsubmit="return confirm('Position «@pos.Name» wirklich löschen?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@pos.Id" />
                            <input type="hidden" name="templateBudgetId" value="@Model.TemplateBudget.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted mb-4">Noch keine Positionen vorhanden.</p>
}

<h5>Position hinzufügen</h5>
<form asp-action="AddPosition" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="TemplateBudgetId" value="@Model.TemplateBudget.Id" />

    <div class="row g-2 align-items-end mb-2">
        <div class="col-md-3">
            <label class="form-label">Name</label>
            <input type="text" name="Name" class="form-control form-control-sm" required />
        </div>
        <div class="col-md-1">
            <label class="form-label">Typ</label>
            <select name="PositionTypeId" class="form-select form-select-sm" required>
                <option value="0">– Typ –</option>
                @foreach (var pt in Model.NewPosition.PositionTypes)
                {
                    <option value="@pt.Id">@pt.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Kategorie</label>
            <select name="CategoryId" id="addCategoryId" class="form-select form-select-sm" required>
                <option value="0">– Kategorie –</option>
                @foreach (var cat in Model.NewPosition.Categories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Unterkategorie</label>
            <select name="SubCategoryId" id="addSubCategoryId" class="form-select form-select-sm">
                <option value="">– Unterkategorie –</option>
                @foreach (var sub in Model.NewPosition.SubCategories)
                {
                    <option value="@sub.Id" data-category="@sub.CategoryId">@sub.Name</option>
                }
            </select>
        </div>
        <div class="col-md-1">
            <label class="form-label">Fixbetrag</label>
            <input type="number" name="FixedAmount" class="form-control form-control-sm text-end" step="0.01" min="0" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Anzahl</label>
            <input type="number" name="Quantity" class="form-control form-control-sm text-end" step="0.01" min="0" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Einheitspreis</label>
            <input type="number" name="UnitAmount" class="form-control form-control-sm text-end" step="0.01" min="0" />
        </div>
        <div class="col-md-1 d-flex justify-content-end">
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-square"></i>
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const categorySelect = document.getElementById('addCategoryId');
            const subCategorySelect = document.getElementById('addSubCategoryId');
            const allSubOptions = Array.from(subCategorySelect.querySelectorAll('option[data-category]'));

            function filterSubCategories() {
                const selectedCategoryId = categorySelect.value;
                subCategorySelect.innerHTML = '<option value="">– Unterkategorie –</option>';
                allSubOptions
                    .filter(opt => !selectedCategoryId || selectedCategoryId === '0' || opt.dataset.category === selectedCategoryId)
                    .forEach(opt => subCategorySelect.appendChild(opt.cloneNode(true)));
            }

            categorySelect.addEventListener('change', filterSubCategories);
        })();
    </script>
}
