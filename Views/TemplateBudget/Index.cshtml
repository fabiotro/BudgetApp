@model List<TemplateBudgetModel>
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Localizer["PageHeading"]</h2>
    <button type="button" class="btn btn-primary" id="openCreateTemplateModal">
        <span class="me-2">@Localizer["CreateTemplateButton"]</span>
        <i class="bi bi-plus-square"></i>
    </button>
</div>
<hr />

@if (!Model.Any())
{
    <p class="text-muted">@Localizer["NoDataMessage"]</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>@Localizer["ColName"]</th>
                <th>@Localizer["ColDescription"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var template in Model)
            {
                <tr>
                    <td><strong>@template.Name</strong></td>
                    <td>
                        @if (!string.IsNullOrEmpty(template.Description))
                        {
                            <small class="text-muted">@template.Description</small>
                        }
                        else
                        {
                            <span class="text-muted">–</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Detail" asp-route-id="@template.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-secondary open-edit-template-modal"
                                data-id="@template.Id">
                            <i class="bi bi-pen"></i>
                        </button>
                        <form asp-action="DeleteTemplate" method="post" class="d-inline"
                              onsubmit="return confirm('@string.Format(Localizer["ConfirmDeleteTemplate"].Value, template.Name)')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@template.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div id="templateModalContainer"></div>

<script>
    function openTemplateModal(url) {
        fetch(url)
            .then(r => r.text())
            .then(html => {
                const container = document.getElementById('templateModalContainer');
                container.innerHTML = html;
                new bootstrap.Modal(container.querySelector('.modal')).show();
            });
    }

    document.getElementById('openCreateTemplateModal').addEventListener('click', function () {
        openTemplateModal('@Url.Action("UpsertModal", "TemplateBudget")');
    });

    document.querySelectorAll('.open-edit-template-modal').forEach(function (btn) {
        btn.addEventListener('click', function () {
            openTemplateModal('@Url.Action("UpsertModal", "TemplateBudget")' + '?id=' + this.dataset.id);
        });
    });
</script>
