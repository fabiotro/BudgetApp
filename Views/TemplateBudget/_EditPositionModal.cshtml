@model UpsertTemplatePositionViewModel

<div class="modal fade" id="editPositionModal" tabindex="-1" aria-labelledby="editPositionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editPositionModalLabel">Position bearbeiten</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schliessen"></button>
            </div>
            <form asp-action="SavePosition" asp-controller="TemplateBudget" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="TemplateBudgetId" />
                <input type="hidden" asp-for="SortIndex" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="PositionTypeId" class="form-label"></label> <span class="text-danger">*</span>
                        <select asp-for="PositionTypeId" class="form-select" required
                                asp-items="@(new SelectList(Model.PositionTypes, "Id", "Name"))">
                            <option value="0">– Typ –</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label"></label> <span class="text-danger">*</span>
                        <select asp-for="CategoryId" id="editModalCategoryId" class="form-select" required
                                asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                            <option value="0">– Kategorie –</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SubCategoryId" class="form-label"></label>
                        <select asp-for="SubCategoryId" id="editModalSubCategoryId" class="form-select">
                            <option value="">– Unterkategorie –</option>
                            @foreach (var sub in Model.SubCategories)
                            {
                                <option value="@sub.Id" data-category="@sub.CategoryId">@sub.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FixedAmount" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">CHF</span>
                            <input asp-for="FixedAmount" type="text" inputmode="decimal" class="form-control text-end" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Quantity" class="form-label"></label>
                        <input type="hidden" id="editTpQvar" name="QuantityVar" value="@Model.QuantityVar" />
                        <select id="editTpQvarSelect" class="form-select mb-2" data-initial="@Model.QuantityVar">
                            <option value="">– Zahl –</option>
                            <option value="ParticipantsCount">Teilnehmer</option>
                            <option value="js_PersonsCount">J+S Pers.</option>
                            <option value="LeadersTeamCount">Leitungsteam</option>
                        </select>
                        <input asp-for="Quantity" type="number" id="editTpQty" class="form-control text-end" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="UnitAmount" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">CHF</span>
                            <input asp-for="UnitAmount" type="text" inputmode="decimal" class="form-control text-end" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
                    <button type="submit" class="btn btn-primary">Speichern <i class="bi bi-floppy"></i></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        const categorySelect = document.getElementById('editModalCategoryId');
        const subCategorySelect = document.getElementById('editModalSubCategoryId');
        const allSubOptions = Array.from(subCategorySelect.querySelectorAll('option[data-category]'));
        const initialSubId = '@Model.SubCategoryId';

        function filterSubCategories(keepSelection) {
            const selectedCategoryId = categorySelect.value;
            subCategorySelect.innerHTML = '<option value="">– Unterkategorie –</option>';
            allSubOptions
                .filter(opt => selectedCategoryId && selectedCategoryId !== '0' && opt.dataset.category === selectedCategoryId)
                .forEach(opt => {
                    const clone = opt.cloneNode(true);
                    if (keepSelection && clone.value === initialSubId)
                        clone.selected = true;
                    subCategorySelect.appendChild(clone);
                });
        }

        filterSubCategories(true);
        categorySelect.addEventListener('change', () => filterSubCategories(false));

        // Quantity variable
        const qvarHidden = document.getElementById('editTpQvar');
        const qvarSelect = document.getElementById('editTpQvarSelect');
        const qtyInput   = document.getElementById('editTpQty');

        function syncQvar(v) {
            qvarHidden.value = v;
            if (v) { qtyInput.value = '0'; qtyInput.disabled = true; }
            else   { qtyInput.disabled = false; }
        }
        const initialQvar = qvarSelect.dataset.initial;
        if (initialQvar) { qvarSelect.value = initialQvar; syncQvar(initialQvar); }
        qvarSelect.addEventListener('change', function () { syncQvar(this.value); });
        qtyInput.addEventListener('input', function () {
            qvarSelect.disabled = this.value !== '' && parseFloat(this.value) !== 0;
        });
    })();
</script>
