@model CreateTransactionViewModel
@using BudgetApp.Enums
@{
    string PaymentSourceLabel(PaymentSource s) => s switch
    {
        PaymentSource.PersonalMoney => "Privatgeld",
        PaymentSource.Budget        => "Lagerkasse",
        PaymentSource.OtherAdvance  => "Andere Vorauszahlung",
        _                           => s.ToString()
    };

    string PaymentMethodLabel(PaymentMethod m) => m switch
    {
        PaymentMethod.Cash  => "Bargeld",
        PaymentMethod.Card  => "Karte",
        PaymentMethod.Bill  => "Rechnung",
        PaymentMethod.Other => "Andere",
        _                   => m.ToString()
    };
}

<div class="modal fade" id="createTransactionModal" tabindex="-1" aria-labelledby="createTransactionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createTransactionModalLabel">Ausgabe erfassen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schliessen"></button>
            </div>
            <form asp-controller="Transaction" asp-action="Create" method="post" enctype="multipart/form-data">
                <input asp-for="BudgetId" type="hidden" />
                <input asp-for="ReturnUrl" type="hidden" />
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="PerformedByUserId" class="form-label"></label>
                            <select asp-for="PerformedByUserId" class="form-select">
                                @foreach (var bu in Model.BudgetUsers)
                                {
                                    <option value="@bu.UserId">@bu.DisplayName</option>
                                }
                            </select>
                            <span asp-validation-for="PerformedByUserId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Amount" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">CHF</span>
                                <input asp-for="Amount" class="form-control" type="text" inputmode="decimal" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PaymentSource" class="form-label"></label>
                            <select asp-for="PaymentSource" class="form-select">
                                @foreach (PaymentSource s in Enum.GetValues(typeof(PaymentSource)))
                                {
                                    <option value="@((int)s)">@PaymentSourceLabel(s)</option>
                                }
                            </select>
                            <span asp-validation-for="PaymentSource" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PaymentMethod" class="form-label"></label>
                            <select asp-for="PaymentMethod" class="form-select">
                                @foreach (PaymentMethod m in Enum.GetValues(typeof(PaymentMethod)))
                                {
                                    <option value="@((int)m)">@PaymentMethodLabel(m)</option>
                                }
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                        </div>

                        @if (Model.Positions.Any())
                        {
                            <div class="col-md-6">
                                <label asp-for="PositionId" class="form-label">Budgetposition (optional)</label>
                                <select asp-for="PositionId" class="form-select">
                                    <option value="">— keine —</option>
                                    @foreach (var pos in Model.Positions)
                                    {
                                        <option value="@pos.Id">@pos.Name</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <input asp-for="PositionId" type="hidden" />
                        }

                        <div class="col-12">
                            <label class="form-label">Belege (Fotos, PDF)</label>
                            <input type="file" name="attachments" class="form-control"
                                   multiple accept="image/*,.pdf" capture="environment" />
                            <div class="form-text">Erlaubte Formate: JPG, PNG, WEBP, GIF, PDF. Max. 10 MB pro Datei.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
                    <button type="submit" class="btn btn-primary">
                        Ausgabe speichern <i class="bi bi-floppy"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
