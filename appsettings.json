{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "async": true,
      "logfile": {
        "type": "File",
        "fileName": "${basedir}/logs/nlog-${shortdate}.log",
        "createDirs": true
      },
      "logconsole": {
        "type": "ColoredConsole"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logconsole"
      },
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "logfile"
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=PHIBUSHVSQL\\SQL2019;Initial Catalog=WebApplication1;Persist Security Info=True;User ID=sa;Password=021@sql;Encrypt=True;TrustServerCertificate=True;"
  }
}
